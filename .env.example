# Google Gemini API key (create one in Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here

# LLM
LLM_MODEL=gemini-3.5-flash-lite
LLM_MAX_TOKENS=1024

# Embeddings / reranking
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_TOP_K=5

# Chunking
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# Retrieval
VECTOR_TOP_K=10
BM25_TOP_K=10
HYBRID_ALPHA=0.5

# Level-3 orchestration
MAX_HOPS=3
MIN_CONTEXT_SCORE=0.35
GROUNDEDNESS_THRESHOLD=0.7

# Storage (relative to the project root)
UPLOAD_DIR=./data/uploads
VECTOR_STORE_DIR=./data/vector_store
COLLECTION_NAME=km_documents

# API
API_HOST=127.0.0.1
API_PORT=8000

# Frontend origin(s), comma-separated. Use * only for a trusted local demo.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Demo authentication - CHANGE THESE before sharing the project.
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_PASSWORD=admin123
VIEWER_PASSWORD=viewer123
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=604800
